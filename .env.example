# ==========================================
# LinkPulse Environment Variables Template
# Copy this file to .env or .env.local
# DO NOT commit real secrets to source control
# ==========================================

# 1. Database Connections (Supabase PostgreSQL)
# Transaction pooler connection string on port 6543 (used by Prisma at runtime, IPv4 compatible)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Session pooler or direct connection string on port 5432 (required for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"


# 2. Authentication (Auth.js)
# Secret key used to encrypt session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-characters"

# Canonical URL of the site for auth redirect checks
AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (create in Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 3. Redis Cache and Rate Limiting (Upstash)
# Upstash Redis REST API endpoint
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"

# Upstash Redis REST access token
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# 4. Public Application Settings
# Public URL used in frontend links, redirect logic, and QR generation
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to true to make the frontend return mock data from mock/ directory
NEXT_PUBLIC_USE_MOCKS="false"

# 5. Local Development Auth Fallback (local development only, ignored in production)
# DEV_FAKE_USER_ID="clz123456000008l8g8a3z4x1"
# DEV_FAKE_USER_ROLE="USER"

